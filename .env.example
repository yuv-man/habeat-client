# Copy this file to .env and set the values for your environment.

# PostHog project API key. The app sends analytics, session replay, and error
# tracking to PostHog only when this key is set. A build without this key runs
# fine but reports no events. The project lives on PostHog EU cloud; the host is
# set in src/lib/analytics.ts.
VITE_POSTHOG_KEY=

# Backend API base URLs.
VITE_BASE_URL_DEV=
VITE_BASE_URL_PROD=

# Google sign-in client IDs.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID_IOS=
VITE_GOOGLE_CLIENT_ID_ANDROID=

# Force a Google auth mode: "web" or "mobile". Optional.
VITE_GOOGLE_AUTH_MODE=

# Run the app without a backend for local tests. Optional; set to "true".
VITE_TEST_FRONTEND=
